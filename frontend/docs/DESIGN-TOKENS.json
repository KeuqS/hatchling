{
  "version": 1,
  "guide": "STYLE_GUIDE.md",
  "tokensFile": "src/styles/tokens.css",
  "requiredTokens": {
    "--space-1": "calc(4px * var(--ui-space, 1))",
    "--space-2": "calc(8px * var(--ui-space, 1))",
    "--space-3": "calc(12px * var(--ui-space, 1))",
    "--space-4": "calc(16px * var(--ui-space, 1))",
    "--space-6": "calc(24px * var(--ui-space, 1))",
    "--space-8": "calc(32px * var(--ui-space, 1))",
    "--space-12": "calc(48px * var(--ui-space, 1))",
    "--radius-xs": "6px",
    "--radius-sm": "10px",
    "--radius-md": "14px",
    "--radius-lg": "18px",
    "--radius-xl": "24px",
    "--radius-pill": "999px",
    "--text-xs": "calc(12px * var(--ui-scale, 1))",
    "--text-sm": "calc(14px * var(--ui-scale, 1))",
    "--text-body": "calc(16px * var(--ui-scale, 1))",
    "--text-title": "calc(20px * var(--ui-scale, 1))",
    "--control-touch": "44px",
    "--motion-fast": "140ms",
    "--motion-standard": "180ms",
    "--motion-ease": "cubic-bezier(.2, .8, .2, 1)",
    "--skeleton-base": "color-mix(in srgb, var(--text) 13%, var(--bg))",
    "--skeleton-line-height": "calc(12px * var(--ui-scale, 1))",
    "--skeleton-title-height": "calc(17px * var(--ui-scale, 1))",
    "--skeleton-avatar-size": "calc(40px * var(--ui-space, 1))",
    "--skeleton-pulse-duration": "1800ms",
    "--loading-reveal-delay": "120ms",
    "--menu-bg": "var(--composer-bg)",
    "--menu-border": "var(--border)",
    "--menu-hover": "color-mix(in srgb, var(--text) 7%, var(--menu-bg))",
    "--menu-shadow": "0 8px 20px color-mix(in srgb, var(--bg) 20%, transparent)",
    "--menu-radius": "var(--radius-lg)",
    "--menu-item-radius": "var(--radius-sm)",
    "--menu-padding": "8px",
    "--menu-min-width": "calc(240px * var(--ui-space, 1))",
    "--menu-item-height": "calc(36px * var(--ui-space, 1))",
    "--menu-icon-size": "16px",
    "--menu-gap": "10px",
    "--menu-divider": "color-mix(in srgb, var(--text) 13%, var(--menu-bg))"
