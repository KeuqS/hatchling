    "src/styles/approvals.css",
    "src/styles/chat-navigation.css",
    "src/styles/conversation.css",
    "src/styles/details.css",
    "src/styles/interactions.css",
    "src/styles/polish.css",
    "src/styles/refinements.css",
    "src/styles/reliability.css",
    "src/styles/surfaces.css",
    "src/styles/touchup.css",
    "src/styles/workspace.css"
